<Window
    x:Class="ChronoDesk.App.Views.AboutWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:ChronoDesk.App.Localization"
    Title="{x:Static loc:Strings.AboutTitle}"
    Width="700"
    Height="640"
    MinWidth="620"
    MinHeight="540"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False"
    Icon="/Assets/chronodesk.ico">
  <Grid RowDefinitions="*,Auto" Margin="28">
    <ScrollViewer>
      <StackPanel Spacing="18">
        <Grid ColumnDefinitions="96,*" ColumnSpacing="18">
          <Border Width="88" Height="88" CornerRadius="22" Background="{DynamicResource ChronoSurfaceBrush}" BorderBrush="{DynamicResource ChronoBorderBrush}" BorderThickness="1">
            <Canvas Width="88" Height="88">
              <Ellipse Width="68" Height="68" Canvas.Left="10" Canvas.Top="8" Stroke="{DynamicResource ChronoAccentBrush}" StrokeThickness="6" />
              <Path Data="M44,42 L44,23 M44,42 L59,51" Stroke="White" StrokeThickness="6" StrokeLineCap="Round" />
              <Ellipse Width="8" Height="8" Canvas.Left="40" Canvas.Top="38" Fill="White" />
              <Path Data="M18,76 L70,76" Stroke="{DynamicResource ChronoAccentBrush}" StrokeThickness="6" StrokeLineCap="Round" />
            </Canvas>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
            <TextBlock Text="{x:Static loc:Strings.AppName}" FontSize="32" FontWeight="Bold" />
            <TextBlock x:Name="VersionText" Classes="muted" />
            <TextBlock Text="{x:Static loc:Strings.Credit}" FontWeight="SemiBold" />
          </StackPanel>
        </Grid>

        <TextBlock Text="{x:Static loc:Strings.AboutDescription}" TextWrapping="Wrap" FontSize="16" />

        <Border Classes="card">
          <StackPanel Spacing="10">
            <TextBlock Text="{x:Static loc:Strings.ProjectTitle}" Classes="sectionTitle" />
            <Button Content="{x:Static loc:Strings.GitHubButton}" HorizontalAlignment="Left" Click="GitHubButton_OnClick" />
            <Button Content="{x:Static loc:Strings.BmcButton}" Classes="primary" HorizontalAlignment="Left" Click="BmcButton_OnClick" />
            <TextBlock Text="{x:Static loc:Strings.DonationNote}" Classes="muted" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="10">
            <TextBlock Text="{x:Static loc:Strings.ContactSupportTitle}" Classes="sectionTitle" />
            <Button Content="{x:Static loc:Strings.BusinessPrimary}" HorizontalAlignment="Left" Click="BusinessPrimaryButton_OnClick" />
            <Button Content="{x:Static loc:Strings.BusinessSecondary}" HorizontalAlignment="Left" Click="BusinessSecondaryButton_OnClick" />
            <Button Content="{x:Static loc:Strings.SupportAddress}" HorizontalAlignment="Left" Click="SupportButton_OnClick" />
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Text="{x:Static loc:Strings.LicensePrivacyTitle}" Classes="sectionTitle" />
            <TextBlock Text="{x:Static loc:Strings.LicensePrivacyBody}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Button Grid.Row="1" Content="{x:Static loc:Strings.ActionClose}" HorizontalAlignment="Right" Margin="0,18,0,0" Click="CloseButton_OnClick" />
  </Grid>
</Window>
