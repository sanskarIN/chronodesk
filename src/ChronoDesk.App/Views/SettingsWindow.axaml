<Window
    x:Class="ChronoDesk.App.Views.SettingsWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:ChronoDesk.App.Localization"
    Title="{x:Static loc:Strings.SettingsTitle}"
    Width="860"
    Height="720"
    MinWidth="720"
    MinHeight="600"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False"
    Icon="/Assets/chronodesk.ico">

  <Grid RowDefinitions="Auto,*,Auto">
    <StackPanel Margin="24,20,24,14" Spacing="4">
      <TextBlock Text="{x:Static loc:Strings.SettingsHeading}" FontSize="30" FontWeight="Bold" />
      <TextBlock Text="{x:Static loc:Strings.SettingsDescription}" Classes="muted" />
    </StackPanel>

    <TabControl Grid.Row="1" Margin="20,0">
      <TabItem Header="{x:Static loc:Strings.TabClock}">
        <ScrollViewer>
          <StackPanel Margin="8,18" Spacing="18">
            <Border Classes="card">
              <StackPanel Spacing="12">
                <TextBlock Text="{x:Static loc:Strings.ClockDisplayTitle}" Classes="sectionTitle" />
                <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="12">
                  <TextBlock Text="{x:Static loc:Strings.TimeFormatLabel}" VerticalAlignment="Center" />
                  <ComboBox x:Name="FormatCombo" Grid.Column="1" SelectedIndex="1">
                    <ComboBoxItem Content="{x:Static loc:Strings.Format12}" />
                    <ComboBoxItem Content="{x:Static loc:Strings.Format24}" />
                  </ComboBox>
                  <TextBlock Grid.Row="1" Text="{x:Static loc:Strings.ShowSeconds}" VerticalAlignment="Center" />
                  <CheckBox x:Name="ShowSecondsCheck" Grid.Row="1" Grid.Column="1" />
                  <TextBlock Grid.Row="2" Text="{x:Static loc:Strings.ShowDate}" VerticalAlignment="Center" />
                  <CheckBox x:Name="ShowDateCheck" Grid.Row="2" Grid.Column="1" />
                  <TextBlock Grid.Row="3" Text="{x:Static loc:Strings.ShowWeekday}" VerticalAlignment="Center" />
                  <CheckBox x:Name="ShowWeekdayCheck" Grid.Row="3" Grid.Column="1" />
                  <TextBlock Grid.Row="4" Text="{x:Static loc:Strings.ShowWeekNumber}" VerticalAlignment="Center" />
                  <CheckBox x:Name="ShowWeekNumberCheck" Grid.Row="4" Grid.Column="1" />
                  <TextBlock Grid.Row="5" Text="{x:Static loc:Strings.ShowCalendarDetails}" VerticalAlignment="Center" />
                  <CheckBox x:Name="ShowCalendarDetailsCheck" Grid.Row="5" Grid.Column="1" />
                </Grid>
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="12">
                <TextBlock Text="{x:Static loc:Strings.ChimeTitle}" Classes="sectionTitle" />
                <CheckBox x:Name="ChimeEnabledCheck" Content="{x:Static loc:Strings.EnableChime}" />
                <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12">
                  <TextBlock Text="{x:Static loc:Strings.IntervalLabel}" VerticalAlignment="Center" />
                  <ComboBox x:Name="ChimeIntervalCombo" Grid.Column="1" SelectedIndex="0">
                    <ComboBoxItem Content="{x:Static loc:Strings.IntervalHourly}" />
                    <ComboBoxItem Content="{x:Static loc:Strings.IntervalHalf}" />
                    <ComboBoxItem Content="{x:Static loc:Strings.IntervalQuarter}" />
                  </ComboBox>
                  <TextBlock Grid.Row="1" Text="{x:Static loc:Strings.QuietHoursLabel}" VerticalAlignment="Center" />
                  <CheckBox x:Name="QuietHoursCheck" Grid.Row="1" Grid.Column="1" />
                  <TextBlock Grid.Row="2" Text="{x:Static loc:Strings.QuietStartLabel}" VerticalAlignment="Center" />
                  <TextBox x:Name="QuietStartText" Grid.Row="2" Grid.Column="1" Watermark="22:00" MaxLength="5" />
                  <TextBlock Grid.Row="3" Text="{x:Static loc:Strings.QuietEndLabel}" VerticalAlignment="Center" />
                  <TextBox x:Name="QuietEndText" Grid.Row="3" Grid.Column="1" Watermark="07:00" MaxLength="5" />
                </Grid>
                <TextBlock Text="{x:Static loc:Strings.ChimeNote}" Classes="muted" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{x:Static loc:Strings.TabAppearance}">
        <ScrollViewer>
          <StackPanel Margin="8,18" Spacing="18">
            <Border Classes="card">
              <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="14">
                <TextBlock Text="{x:Static loc:Strings.ThemeLabel}" VerticalAlignment="Center" />
                <ComboBox x:Name="ThemeCombo" Grid.Column="1">
                  <ComboBoxItem Content="{x:Static loc:Strings.ThemeSystem}" />
                  <ComboBoxItem Content="{x:Static loc:Strings.ThemeLight}" />
                  <ComboBoxItem Content="{x:Static loc:Strings.ThemeDark}" />
                  <ComboBoxItem Content="{x:Static loc:Strings.ThemeHighContrast}" />
                </ComboBox>
                <TextBlock Grid.Row="1" Text="{x:Static loc:Strings.LayoutLabel}" VerticalAlignment="Center" />
                <ComboBox x:Name="LayoutCombo" Grid.Row="1" Grid.Column="1">
                  <ComboBoxItem Content="{x:Static loc:Strings.LayoutCentered}" />
                  <ComboBoxItem Content="{x:Static loc:Strings.LayoutCompact}" />
                  <ComboBoxItem Content="{x:Static loc:Strings.LayoutDashboard}" />
                </ComboBox>
                <TextBlock Grid.Row="2" Text="{x:Static loc:Strings.FontFamilyLabel}" VerticalAlignment="Center" />
                <TextBox x:Name="FontFamilyText" Grid.Row="2" Grid.Column="1" Watermark="Inter" />
                <TextBlock Grid.Row="3" Text="{x:Static loc:Strings.ClockSizeLabel}" VerticalAlignment="Center" />
                <Slider x:Name="FontSizeSlider" Grid.Row="3" Grid.Column="1" Minimum="42" Maximum="240" TickFrequency="2" />
                <TextBlock Grid.Row="4" Text="{x:Static loc:Strings.ContentSpacingLabel}" VerticalAlignment="Center" />
                <Slider x:Name="SpacingSlider" Grid.Row="4" Grid.Column="1" Minimum="4" Maximum="48" TickFrequency="1" />
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{x:Static loc:Strings.TabAccessibility}">
        <ScrollViewer>
          <StackPanel Margin="8,18" Spacing="18">
            <Border Classes="card">
              <StackPanel Spacing="12">
                <TextBlock Text="{x:Static loc:Strings.AccessibilityTitle}" Classes="sectionTitle" />
                <CheckBox x:Name="ReducedMotionCheck" Content="{x:Static loc:Strings.ReducedMotion}" />
                <CheckBox x:Name="HighContrastCheck" Content="{x:Static loc:Strings.UseHighContrast}" />
                <TextBlock Text="{x:Static loc:Strings.AccessibilityNote}" Classes="muted" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Text="{x:Static loc:Strings.KeyboardShortcutsTitle}" Classes="sectionTitle" />
                <TextBlock Text="{x:Static loc:Strings.ShortcutFocus}" />
                <TextBlock Text="{x:Static loc:Strings.ShortcutMini}" />
                <TextBlock Text="{x:Static loc:Strings.ShortcutSearch}" />
                <TextBlock Text="{x:Static loc:Strings.ShortcutSettings}" />
                <TextBlock Text="{x:Static loc:Strings.ShortcutTopmost}" />
                <TextBlock Text="{x:Static loc:Strings.ShortcutEscape}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{x:Static loc:Strings.TabBehavior}">
        <ScrollViewer>
          <StackPanel Margin="8,18" Spacing="18">
            <Border Classes="card">
              <StackPanel Spacing="12">
                <TextBlock Text="{x:Static loc:Strings.WindowStartupTitle}" Classes="sectionTitle" />
                <CheckBox x:Name="AlwaysOnTopCheck" Content="{x:Static loc:Strings.AlwaysOnTop}" />
                <CheckBox x:Name="StartWithSystemCheck" Content="{x:Static loc:Strings.StartWithSystem}" />
                <CheckBox x:Name="MinimizeToTrayCheck" Content="{x:Static loc:Strings.MinimizeToTray}" />
                <TextBlock Text="{x:Static loc:Strings.StartupNote}" Classes="muted" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{x:Static loc:Strings.TabDataPrivacy}">
        <ScrollViewer>
          <StackPanel Margin="8,18" Spacing="18">
            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Text="{x:Static loc:Strings.PrivateByDefaultTitle}" Classes="sectionTitle" />
                <TextBlock Text="{x:Static loc:Strings.PrivacyBody}" TextWrapping="Wrap" />
                <TextBlock Text="{x:Static loc:Strings.LoggingPrivacyBody}" Classes="muted" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="12">
                <TextBlock Text="{x:Static loc:Strings.BackupRestoreTitle}" Classes="sectionTitle" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="{x:Static loc:Strings.ActionExportSettings}" Click="ExportButton_OnClick" />
                  <Button Content="{x:Static loc:Strings.ActionImportSettings}" Click="ImportButton_OnClick" />
                  <Button Content="{x:Static loc:Strings.ActionResetDefaults}" Click="ResetButton_OnClick" />
                </StackPanel>
                <TextBlock Text="{x:Static loc:Strings.ExportPrivacyNote}" Classes="muted" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{x:Static loc:SettingsExtras.TabUpdatesAbout}">
        <ScrollViewer>
          <StackPanel Margin="8,18" Spacing="18">
            <Border Classes="card">
              <StackPanel Spacing="12">
                <TextBlock Text="{x:Static loc:SettingsExtras.UpdatesTitle}" Classes="sectionTitle" />
                <TextBlock Text="{x:Static loc:SettingsExtras.UpdatesBody}" TextWrapping="Wrap" />
                <Button
                    x:Name="OpenReleasesButton"
                    Content="{x:Static loc:SettingsExtras.OpenReleases}"
                    HorizontalAlignment="Left"
                    Click="OpenReleasesButton_OnClick" />
                <TextBlock Text="{x:Static loc:SettingsExtras.UpdatePrivacyNote}" Classes="muted" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="12">
                <TextBlock Text="{x:Static loc:SettingsExtras.AboutSectionTitle}" Classes="sectionTitle" />
                <TextBlock x:Name="SettingsVersionText" FontWeight="SemiBold" />
                <TextBlock Text="{x:Static loc:SettingsExtras.AboutSectionBody}" TextWrapping="Wrap" />
                <Button
                    x:Name="OpenAboutButton"
                    Content="{x:Static loc:SettingsExtras.OpenAbout}"
                    HorizontalAlignment="Left"
                    Click="OpenAboutButton_OnClick" />
                <TextBlock Text="{x:Static loc:Strings.Credit}" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <Border Grid.Row="2" BorderBrush="{DynamicResource ChronoBorderBrush}" BorderThickness="0,1,0,0" Padding="24,14">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
        <TextBlock x:Name="SettingsStatusText" Classes="muted" VerticalAlignment="Center" />
        <Button Grid.Column="1" Content="{x:Static loc:Strings.ActionCancel}" Click="CancelButton_OnClick" />
        <Button Grid.Column="2" Content="{x:Static loc:Strings.ActionSaveChanges}" Classes="primary" Click="SaveButton_OnClick" />
      </Grid>
    </Border>
  </Grid>
</Window>
