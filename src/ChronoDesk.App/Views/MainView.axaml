<UserControl
    x:Class="ChronoDesk.App.Views.MainView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:ChronoDesk.App.Localization"
    xmlns:vm="using:ChronoDesk.App.ViewModels"
    AutomationProperties.Name="{x:Static loc:Strings.AutomationWindow}">

  <Grid RowDefinitions="Auto,*,Auto">
    <Border Padding="18,14" BorderBrush="{DynamicResource ChronoBorderBrush}" BorderThickness="0,0,0,1">
      <StackPanel Spacing="2">
        <TextBlock Text="{x:Static loc:Strings.AppName}" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Text="{x:Static loc:Strings.Tagline}" Classes="muted" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="16" Spacing="16">
        <Border Classes="card" MinHeight="250">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch" Spacing="10">
            <TextBlock
                Text="{Binding CurrentTime}"
                Classes="heroClock"
                FontSize="{Binding Settings.ClockFontSize}"
                FontFamily="{Binding Settings.FontFamilyName}"
                AutomationProperties.Name="{x:Static loc:Strings.AutomationCurrentTime}" />
            <WrapPanel HorizontalAlignment="Center">
              <TextBlock Text="{Binding CurrentWeekday}" Margin="6,2" FontSize="17" />
              <TextBlock Text="{Binding CurrentDate}" Margin="6,2" FontSize="17" />
              <TextBlock Text="{Binding CurrentWeekNumber}" Margin="6,2" FontSize="17" />
            </WrapPanel>
            <TextBlock Text="{Binding CalendarDetails}" HorizontalAlignment="Center" Classes="muted" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ZoneName}" HorizontalAlignment="Center" Classes="muted" TextWrapping="Wrap" />
            <WrapPanel HorizontalAlignment="Center" Margin="0,10,0,0">
              <Button Content="{x:Static loc:Strings.ActionToggleFormat}" Margin="4" Click="FormatButton_OnClick" />
              <Button Content="{x:Static loc:Strings.ActionToggleSeconds}" Margin="4" Click="SecondsButton_OnClick" />
            </WrapPanel>
          </StackPanel>
        </Border>

        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="{x:Static loc:Strings.WorldClocksTitle}" Classes="sectionTitle" />
              <TextBlock Text="{x:Static loc:Strings.WorldClocksDescription}" Classes="muted" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding WorldClockCountText}" Classes="muted" VerticalAlignment="Center" Margin="10,0,0,0" />
          </Grid>

          <ItemsControl ItemsSource="{Binding WorldClocks}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:WorldClockCardViewModel">
                <Border Classes="softCard" MinWidth="220" Margin="0,0,8,8">
                  <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding DisplayName}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="1" Content="{x:Static loc:Strings.ActionRemove}" Classes="compact" Tag="{Binding Id}" Click="RemoveWorldClock_OnClick" />
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding TimeText}" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Spacing="2" Margin="0,4,0,0">
                      <TextBlock Text="{Binding DateText}" Classes="muted" />
                      <TextBlock Text="{Binding TimeZoneId}" Classes="muted" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <Border Classes="card">
          <StackPanel Spacing="10">
            <TextBlock Text="{x:Static loc:Strings.AddTimezoneTitle}" Classes="sectionTitle" />
            <TextBlock Text="{x:Static loc:Strings.AddTimezoneDescription}" TextWrapping="Wrap" Classes="muted" />
            <TextBox
                x:Name="TimeZoneSearchBox"
                Classes="searchBox"
                Watermark="{x:Static loc:Strings.TimezoneSearchPlaceholder}"
                TextChanged="TimeZoneSearchBox_OnTextChanged"
                AutomationProperties.Name="{x:Static loc:Strings.AutomationSearchTimezones}" />
            <ListBox x:Name="TimeZoneResults" ItemsSource="{Binding SearchResults}" MaxHeight="220">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="*,Auto" Margin="4">
                    <StackPanel>
                      <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Id}" Classes="muted" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding BaseUtcOffset}" Classes="muted" VerticalAlignment="Center" Margin="10,0,0,0" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Button Content="{x:Static loc:Strings.ActionAddSelectedTimezone}" Classes="primary" HorizontalAlignment="Stretch" Click="AddTimeZoneButton_OnClick" />
            <TextBlock Text="{x:Static loc:Strings.TimezoneOfflineNote}" Classes="muted" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Padding="16,10" BorderBrush="{DynamicResource ChronoBorderBrush}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding StatusMessage}" Classes="muted" TextWrapping="Wrap" />
        <TextBlock Grid.Column="1" Text="{x:Static loc:Strings.Credit}" FontWeight="SemiBold" Margin="12,0,0,0" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
