<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>ChronoDesk.App</RootNamespace>
    <AssemblyName>ChronoDesk.App</AssemblyName>
    <Description>Shared cross-platform Avalonia UI for ChronoDesk.</Description>
    <Version>2.6.0.2</Version>
    <PackageVersion>2.6.0.2</PackageVersion>
    <AssemblyVersion>2.6.0.2</AssemblyVersion>
    <FileVersion>2.6.0.2</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChronoDesk.Core\ChronoDesk.Core.csproj" />
    <ProjectReference Include="..\ChronoDesk.Infrastructure\ChronoDesk.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Diagnostics" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>
</Project>
