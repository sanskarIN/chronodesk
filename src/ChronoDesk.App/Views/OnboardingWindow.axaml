<Window
    x:Class="ChronoDesk.App.Views.OnboardingWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:ChronoDesk.App.Localization"
    Title="{x:Static loc:Strings.OnboardingTitle}"
    Width="720"
    Height="560"
    CanResize="False"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False"
    Icon="/Assets/chronodesk.ico">
  <Grid RowDefinitions="*,Auto" Margin="28">
    <ScrollViewer>
      <StackPanel Spacing="20">
        <StackPanel Spacing="6">
          <TextBlock Text="{x:Static loc:Strings.OnboardingTitle}" FontSize="34" FontWeight="Bold" />
          <TextBlock Text="{x:Static loc:Strings.OnboardingIntro}" FontSize="17" Classes="muted" TextWrapping="Wrap" />
        </StackPanel>

        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Text="{x:Static loc:Strings.OnboardingTimeTitle}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{x:Static loc:Strings.OnboardingTimeBody}" TextWrapping="Wrap" Classes="muted" />
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Text="{x:Static loc:Strings.OnboardingWorldTitle}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{x:Static loc:Strings.OnboardingWorldBody}" TextWrapping="Wrap" Classes="muted" />
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Text="{x:Static loc:Strings.OnboardingAccessTitle}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{x:Static loc:Strings.OnboardingAccessBody}" TextWrapping="Wrap" Classes="muted" />
          </StackPanel>
        </Border>

        <TextBlock Text="{x:Static loc:Strings.OnboardingPrivacy}" FontWeight="SemiBold" />
      </StackPanel>
    </ScrollViewer>

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,20,0,0">
      <TextBlock Text="{x:Static loc:Strings.Credit}" Classes="muted" VerticalAlignment="Center" />
      <Button Grid.Column="1" Content="{x:Static loc:Strings.OnboardingContinue}" Classes="primary" Click="ContinueButton_OnClick" />
    </Grid>
  </Grid>
</Window>
